# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string
# Example format: mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/earlyjobs_ats?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/earlyjobs_ats?retryWrites=true&w=majority"
